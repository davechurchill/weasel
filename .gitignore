# Weasel: keep source and project metadata eligible for version control. Ignore
# only generated build products, local editor state, and per-user runtime data.

# Visual Studio / editor state
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.db-shm
*.VC.db-wal
*.VC.opendb
*.vsidx
*.ipch
*.ipdb
*.iobj
*.idb
*.tlog
*.lastbuildstate

# Compiler and linker intermediates
*.d
*.o
*.obj
*.lo
*.slo
*.pch
*.gch
*.ilk
*.pdb
*.exp
*.manifest

# Common generated build directories. Do not ignore the repository Makefile.
/build/
/Build/
/build-*/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/compile_commands.json
/Testing/

# Manual Visual Studio intermediates and shared runtime output
/visualstudio/Weasel/
/bin/

# Bundled tools and generated release packages
/tools/ffmpeg/*.exe
/tools/ffmpeg/ffmpeg
/tools/ffmpeg/ffplay
/tools/ffmpeg/ffprobe
/dist/

# OS and temporary files
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.log
*.bak
*.swp
*~
